          "options": {
            "buildTarget": "@meshmakers/shared-services:test-build",
            "tsConfig": "projects/meshmakers/shared-services/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": [
              "testing/vitest-setup.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/meshmakers/shared-services/**/*.ts",
              "projects/meshmakers/shared-services/**/*.html",
              "testing/**/*.ts"
