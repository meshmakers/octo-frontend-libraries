    "@progress/kendo-theme-material": "^14.2.0",
    "angular-oauth2-oidc": "^22.0.0",
    "apollo-angular": "^14.1.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.13.0",
    "dockview-angular": "^5.0.0",
    "dockview-core": "^5.0.0",
    "expr-eval": "^2.0.2",
    "marked": "^17.0.3",
    "ngx-markdown": "^22.0.0",
